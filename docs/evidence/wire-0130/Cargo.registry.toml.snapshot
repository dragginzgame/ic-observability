[package]
name = "wire-identity-probe"
version = "0.0.0"
edition.workspace = true
rust-version.workspace = true
publish = false

[dependencies]
ic-metrics = { version = "=0.24.0", default-features = false, features = ["native-wire"] }
ic-wire = { workspace = true, features = ["platform-types"] }
ic-platform = { version = "=0.15.2", default-features = false, features = ["principal"] }
ic-platform-types = { version = "=0.15.1", default-features = false }
serde.workspace = true

[target.'cfg(not(target_family = "wasm"))'.dev-dependencies]
serde_json.workspace = true
